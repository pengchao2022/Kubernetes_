example 3: Install mysql with volume mapped

services:

  mysql_gogo:
   image: mysql:oracle
   ports:
    - "3498:3306"
   environment:
    - "MYSQL_ROOT_PASSWORD=Helloworld2024"
   volumes:
    - /Users/allen/nginx_project/allen2024/data/beibei:/var/lib/mysql





